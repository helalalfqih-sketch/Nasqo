<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="settings_identity" model="ir.ui.view">
        <field name="name">nasqo.settings.identity</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="base_setup.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//setting[@id='partner_autocomplete']" position="attributes">
                <attribute name="title">اقتراح بيانات الشركات عند إضافة جهات اتصال.</attribute>
            </xpath>
            <xpath expr="//setting[field[@name='web_app_name']]" position="attributes">
                <attribute name="help">اسم التطبيق المثبت من المتصفح. هوية نسقو مفعّلة.</attribute>
            </xpath>
            <xpath expr="//field[@name='web_app_name']" position="attributes">
                <attribute name="placeholder">NASQO</attribute>
                <attribute name="readonly">1</attribute>
            </xpath>
            <xpath expr="//setting[button[@name='%(base.action_apikeys_admin)d']]" position="attributes">
                <attribute name="help">تتيح مفاتيح API ربط الأدوات الخارجية بحسابك مع المصادقة متعددة العوامل.</attribute>
            </xpath>
        </field>
    </record>
    <record id="module_form_identity" model="ir.ui.view">
        <field name="name">nasqo.module.form.identity</field>
        <field name="model">ir.module.module</field>
        <field name="inherit_id" ref="base.module_form"/>
        <field name="arch" type="xml">
            <xpath expr="//a[contains(@href,'odoo.com/pricing')]" position="replace">
                <span class="text-muted" invisible="not to_buy or state not in ('uninstalled', 'uninstallable')">غير متاح في هذه النسخة</span>
            </xpath>
        </field>
    </record>
    <record id="module_kanban_identity" model="ir.ui.view">
        <field name="name">nasqo.module.kanban.identity</field>
        <field name="model">ir.module.module</field>
        <field name="inherit_id" ref="base.module_view_kanban"/>
        <field name="arch" type="xml">
            <xpath expr="//a[contains(@href,'odoo.com/pricing')]" position="replace">
                <span class="text-muted small" invisible="state not in ('uninstalled', 'uninstallable')" t-if="record.to_buy.raw_value">غير متاح في هذه النسخة</span>
            </xpath>
        </field>
    </record>
</odoo>
