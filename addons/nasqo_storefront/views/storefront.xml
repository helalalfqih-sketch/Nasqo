<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="homepage" name="NASQO Arabic Storefront Home">
        <t t-call="website.layout">
            <t t-set="additional_title">نسقو | متجر عربي تجريبي</t>
            <main id="wrap" class="oe_structure nasqo-storefront" dir="rtl" lang="ar">
                <section class="nasqo-hero" aria-labelledby="nasqo-hero-title">
                    <div class="container nasqo-hero-inner">
                        <div class="nasqo-mark">NASQO <span>نسقو</span></div>
                        <p class="nasqo-eyebrow">متجر إلكتروني عربي • نسخة تجريبية</p>
                        <h1 id="nasqo-hero-title">كل ما تحتاجه، في مكان واحد</h1>
                        <p class="nasqo-lede">تصفّح المنتجات، أضف اختياراتك إلى السلة، وأكمل طلبك بسهولة. هذه البيئة مخصّصة للاختبار ولا تستقبل طلبات تجارية حقيقية.</p>
                        <div class="nasqo-actions">
                            <a href="/shop" class="nasqo-btn nasqo-btn-primary">تسوّق الآن</a>
                            <a href="/shop/cart" class="nasqo-btn nasqo-btn-secondary">عرض السلة</a>
                        </div>
                    </div>
                </section>
                <section class="container nasqo-benefits" aria-label="مميزات المتجر">
                    <article><span class="nasqo-benefit-icon">✓</span><h2>تصفح واضح</h2><p>منتجات منظمة مع عرض السعر والوصف.</p></article>
                    <article><span class="nasqo-benefit-icon">◈</span><h2>سلة سهلة</h2><p>راجع الكميات قبل إتمام الطلب.</p></article>
                    <article><span class="nasqo-benefit-icon">◎</span><h2>دعم العربية</h2><p>تصميم متجاوب من اليمين إلى اليسار.</p></article>
                </section>
                <section class="container nasqo-featured" aria-labelledby="nasqo-products-title">
                    <div class="nasqo-section-heading">
                        <div><p class="nasqo-eyebrow">مختارات المتجر</p><h2 id="nasqo-products-title">منتجات مقترحة</h2></div>
                        <a href="/shop" class="nasqo-text-link">جميع المنتجات ←</a>
                    </div>
                    <div t-if="products" class="nasqo-product-grid">
                        <t t-foreach="products" t-as="item">
                            <article class="nasqo-product">
                                <a t-att-href="item.website_url" class="nasqo-product-link">
                                    <div class="nasqo-product-placeholder" aria-hidden="true">نسقو</div>
                                    <h3 t-esc="item.name"/>
                                    <p class="nasqo-product-price"><span t-esc="'%.2f' % item.list_price"/><span t-esc="request.env.company.currency_id.symbol"/></p>
                                    <span class="nasqo-product-action">عرض المنتج ←</span>
                                </a>
                            </article>
                        </t>
                    </div>
                    <div t-else="" class="nasqo-empty">
                        <p>المنتجات التجريبية قيد الإعداد.</p>
                        <a href="/shop" class="nasqo-text-link">تصفّح المتجر</a>
                    </div>
                </section>
                <section class="container nasqo-end-section">
                    <h2>هل أنت جاهز للتسوّق؟</h2>
                    <p>اختر منتجاتك ثم تابع إلى السلة وإتمام الطلب داخل بيئة الاختبار.</p>
                    <a href="/shop" class="nasqo-btn nasqo-btn-primary">ابدأ التسوق</a>
                </section>
            </main>
        </t>
    </template>
    <template id="nasqo_shop_rtl" inherit_id="website_sale.products" priority="32" name="NASQO RTL Shop Heading">
        <xpath expr="//div[@id='wrap']" position="attributes">
            <attribute name="class" add="nasqo-shop-rtl" separator=" "/>
            <attribute name="dir">rtl</attribute>
        </xpath>
        <xpath expr="//div[@id='wrap']" position="inside">
            <aside class="nasqo-shop-note" dir="rtl">
                <strong>نسقو • المتجر التجريبي</strong>
                <span>أضف المنتجات إلى سلتك وتابع الطلب. لا تستخدم بيانات دفع حقيقية في هذا الاختبار.</span>
                <a href="/nasqo">العودة للرئيسية</a>
            </aside>
        </xpath>
    </template>
    <template id="nasqo_checkout_rtl" inherit_id="website_sale.checkout_layout" priority="32" name="NASQO RTL Cart and Checkout">
        <xpath expr="//div[@id='wrap']" position="attributes">
            <attribute name="class" add="nasqo-checkout-rtl" separator=" "/>
            <attribute name="dir">rtl</attribute>
        </xpath>
        <xpath expr="//div[@id='wrap']" position="inside">
            <aside class="nasqo-shop-note" dir="rtl" aria-label="بيئة الطلب التجريبية">
                <strong>نسقو • السلة وإتمام الطلب</strong>
                <span>بيئة اختبار فقط. لا تُدخل بيانات دفع حقيقية.</span>
                <a href="/nasqo">الرئيسية</a>
            </aside>
        </xpath>
    </template>
</odoo>
